                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">#{Package\LoadDimCustomer\Northwind_Customers.Outputs[OLE DB Source Output].Columns[Country]} == "USA" || #{Package\LoadDimCustomer\Northwind_Customers.Outputs[OLE DB Source Output].Columns[Country]} == "Canada" || #{Package\LoadDimCustomer\Northwind_Customers.Outputs[OLE DB Source Output].Columns[Country]} == "Mexico" || #{Package\LoadDimCustomer\Northwind_Customers.Outputs[OLE DB Source Output].Columns[Country]} == "Brazil" || #{Package\LoadDimCustomer\Northwind_Customers.Outputs[OLE DB Source Output].Columns[Country]} == "Argentina" || #{Package\LoadDimCustomer\Northwind_Customers.Outputs[OLE DB Source Output].Columns[Country]} == "Venezuela" ? "Americas" : "Europe"</property>
