                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">Country == "USA" || Country == "Canada" || Country == "Mexico" || Country == "Brazil" || Country == "Argentina" || Country == "Venezuela" ? "Americas" : "Europe"</property>
                      </properties>
                    </outputColumn>
